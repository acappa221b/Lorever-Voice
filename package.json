{
  "name": "lorever-voice-studio",
  "productName": "Lorever Voice Studio",
  "version": "1.0.0",
  "description": "Record your own narration for the Lorever add-on, section by section, and export it as a voice pack.",
  "author": "acappa221b",
  "license": "GPL-3.0-only",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.acappa221b.loreverstudio",
    "productName": "Lorever Voice Studio",
    "files": [
      "app/**/*",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "LoreverVoiceStudio-${version}.exe"
    }
  }
}
